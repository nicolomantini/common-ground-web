RESEND_API_KEY=
EMAIL_DELIVERY=off
EMAIL_TEST_RECIPIENT=

# sqlite (offline default) or supabase-test (requires private connection config)
CG_EVENTS_BACKEND=sqlite

# Automatic guest sign-in/booking emails: off or test
EMAIL_AUTOMATIC=off
EMAIL_TEST_ALLOWLIST=

# Enable only after saving ~/.config/common-ground/stripe-test-key
STRIPE_MODE=off
